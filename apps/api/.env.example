# --- CodeApt API ---
# Copy to `apps/api/.env` for local dev. The JWT secrets below are DEV-ONLY
# placeholders so the stack boots out of the box — generate real random values
# (`openssl rand -hex 32`) for any shared/staging/production environment.

NODE_ENV=development
LOG_LEVEL=info
PORT=4000

MONGODB_URI=mongodb://127.0.0.1:27017/codeapt
REDIS_URL=redis://localhost:6379

CORS_ORIGIN=http://localhost:5173

JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32char
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Auth cookies ---
# lax = CSRF-safe for a same-site SPA (default). Use "none" (needs HTTPS) only
# for a cross-site SPA, paired with a CSRF token. Secure is forced on in prod.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.codeapt.in

# --- Auth rate limiting (login/register/refresh) ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# --- Bulk enroll (roster importer) default password for provisioned students ---
# Newly-created students get this password and must reset it on first login.
BULK_ENROLL_DEFAULT_PASSWORD=CodeApt@123

# --- Admin bootstrap (used only by `pnpm --filter @codeapt/api seed:admin`) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@codeapt.in
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
ADMIN_ROLL_NUMBER=ADMIN-0001

# Optional integrations (leave blank until their step).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# --- Payments ---
# Gateway adapter: mock (default, offline, deterministic) | phonepe.
PAYMENT_GATEWAY=mock
# Secret the MOCK gateway signs/verifies callbacks with (dev default exists).
PAYMENT_MOCK_SALT=mock-payment-salt-dev-only
# Where the buyer returns after checkout, and the server-to-server webhook URL.
PAYMENT_REDIRECT_URL=http://localhost:5173/payments/return
PAYMENT_CALLBACK_URL=http://localhost:4000/api/payments/callback

# PhonePe (only required when PAYMENT_GATEWAY=phonepe)
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_VERSION=
PHONEPE_ENV=SANDBOX
PHONEPE_CALLBACK_URL=
# X-VERIFY signing material + hosted-checkout base URL.
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=
PHONEPE_TIMEOUT_MS=15000

AI_SERVICE_URL=
PISTON_URL=

# --- LLM Gateway (multi-provider router) ---
# Server-side key that encrypts provider API keys AT REST (AES-256-GCM). REQUIRED
# to add/store provider keys from the AI Providers admin page; without it the
# gateway stays OFF (single-provider fallback) and key saves fail. Any string
# >= 16 chars (stretched to 32 bytes via SHA-256). Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Per-provider request timeout used by the gateway adapters (ms).
LLM_GATEWAY_TIMEOUT_MS=45000
