{
  "name": "@codeapt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeApt Express REST API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "backfill:tenancy": "tsx src/scripts/backfill-tenancy.ts",
    "backfill:enrollment-expiry": "tsx src/scripts/backfill-enrollment-expiry.ts",
    "backfill:ai-entitlements": "tsx src/scripts/backfill-ai-entitlements.ts",
    "backfill:coding-verified": "tsx src/scripts/backfill-coding-verified.ts",
    "seed:curriculum": "tsx src/scripts/seed-curriculum.ts",
    "seed:challenges": "tsx src/scripts/seed-challenges.ts",
    "seed:exams": "tsx src/scripts/seed-exams.ts",
    "seed:essays": "tsx src/scripts/seed-essays.ts",
    "seed:payments": "tsx src/scripts/seed-payments.ts",
    "seed:careers": "tsx src/scripts/seed-careers.ts",
    "seed:speaking": "tsx src/scripts/seed-speaking.ts",
    "gateway:healthcheck": "tsx src/scripts/gateway-healthcheck.ts",
    "fix:migration-dupes": "tsx src/scripts/fix-migration-duplicates.ts"
  },
  "dependencies": {
    "@codeapt/shared": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "pg": "^8.22.0",
    "pg-sdk-node": "^2.0.2",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.2",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
