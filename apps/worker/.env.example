# --- CodeApt Worker ---
# Copy to `apps/worker/.env` for local dev.

NODE_ENV=development
LOG_LEVEL=info

REDIS_URL=redis://localhost:6379
# Same database the API writes ExecutionJob docs to.
MONGODB_URI=mongodb://127.0.0.1:27017/codeapt
WORKER_CONCURRENCY=5

# --- Piston (code execution) ---
# PRIMARY Piston instance. The base must be the one where "<base>/execute" is
# the real endpoint:
#   Self-hosted (docker-compose):  http://localhost:2000/api/v2
#   DevTunnel to a self-hosted box: https://<tunnel-host>/api/v2
# NOTE: a self-hosted Piston serves its API at /api/v2 (NOT /api/v2/piston —
# that extra "/piston" segment is specific to the public emkc routing).
PISTON_URL=http://localhost:2000/api/v2
# FALLBACK Piston, used only when the primary fails (network/timeout/non-2xx).
# The public emkc instance is WHITELIST-ONLY since 2026-02-15 (returns 401), so
# it is no longer a usable public fallback — point this at a second self-hosted
# instance, or set it equal to PISTON_URL to disable the fallback (no-op).
PISTON_FALLBACK_URL=http://localhost:2000/api/v2
# Optional extra header, sent to the PRIMARY only (a DevTunnel needs its
# anti-phishing skip header on browser GETs; API POSTs work without it too).
# PISTON_HEADER_NAME=X-Tunnel-Skip-Anti-Phishing-Page
# PISTON_HEADER_VALUE=true
PISTON_TIMEOUT_MS=15000
# Request "*" (any installed version) by default so execution works regardless
# of the instance's exact patch versions. Set true to pin PISTON_RUNTIMES versions.
# PISTON_PIN_RUNTIME_VERSIONS=false
# Demo/offline only: simulate Piston (no network). Set false for REAL execution.
# NEVER enable in prod.
PISTON_MOCK=false

# --- Essay AI grading ---
# Adapter for the AI layer on top of the deterministic engine:
#   mock         — no network, deterministic-from-text scores (default; demo)
#   microservice — POST to ESSAY_AI_URL/analyze
#   llm          — OpenAI-compatible chat completions
ESSAY_AI_PROVIDER=mock
ESSAY_AI_TIMEOUT_MS=45000

# microservice adapter — base URL + optional auth header.
# ESSAY_AI_URL=http://localhost:8000
# ESSAY_AI_HEADER_NAME=X-Api-Key
# ESSAY_AI_HEADER_VALUE=your-key

# llm adapter — OpenAI-compatible endpoint + key + model.
# ESSAY_LLM_URL=https://api.openai.com/v1
# ESSAY_LLM_API_KEY=sk-...
# ESSAY_LLM_MODEL=gpt-4o-mini

# --- LLM Gateway (multi-provider router) ---
# Use the SAME value as the API's ENCRYPTION_KEY (they share the encrypted
# provider keys in the DB). When set, essay grading routes through the gateway;
# when unset, the worker keeps the single-provider fallback above.
ENCRYPTION_KEY=
LLM_GATEWAY_TIMEOUT_MS=45000
