{
  "name": "@codeapt/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CodeApt BullMQ worker service (code execution + grading)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
