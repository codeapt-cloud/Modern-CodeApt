# --- CodeApt Web (Vite) ---
# Copy to `apps/web/.env` for local dev. Only VITE_* vars reach the browser.
# Leave empty in dev: requests hit /api same-origin and Vite proxies to the API.

VITE_API_URL=

# Cloudinary cloud name — used by lib/cloudinary.ts imageUrl() to expand bare
# Cloudinary public-ids (from migrated Django data) into full delivery URLs.
# Full URLs from new uploads pass through unchanged.
VITE_CLOUDINARY_CLOUD_NAME=

# Off-repo URL for the 3D interviewer avatar GLB (Step 37). The 36.8 MB CC0
# mpfb.glb is NOT committed (Cloudflare Pages rejects files > 25 MiB) — host it on
# Cloudinary (raw/upload) or any CDN and put the URL here. Unset → the runner shows
# the static SVG with a "model not found" status. e.g.
# https://res.cloudinary.com/<cloud>/raw/upload/v1/codeapt/avatar/mpfb.glb
VITE_AVATAR_GLB_URL=
