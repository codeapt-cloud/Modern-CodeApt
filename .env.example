# ============================================================================
# CodeApt — FULL environment inventory (root reference)
# ============================================================================
# This file documents every variable the system uses. Each app also has its
# own .env.example (apps/api, apps/worker, apps/web) with the subset it needs.
# Copy the per-app files to `.env` for local dev. NEVER commit real secrets.
# All datetimes are handled as UTC; IST is a display concern only.
# ----------------------------------------------------------------------------

# --- Shared runtime ---
NODE_ENV=development
LOG_LEVEL=info

# --- Datastores (used by docker-compose + apps) ---
# Local defaults match docker-compose service names / ports.
MONGODB_URI=mongodb://127.0.0.1:27017/codeapt
REDIS_URL=redis://localhost:6379

# --- API server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Auth (REQUIRED — generate strong random values; no fallbacks in code) ---
# e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Auth cookies ---
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# --- Auth rate limiting ---
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# --- Admin bootstrap (seed:admin script only) ---
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
ADMIN_ROLL_NUMBER=ADMIN-0001

# --- Worker ---
WORKER_CONCURRENCY=5

# --- Cloudinary (media) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (gateway + coupons) ---
# Adapter: mock (default, offline) | phonepe.
PAYMENT_GATEWAY=mock
PAYMENT_MOCK_SALT=mock-payment-salt-dev-only
PAYMENT_REDIRECT_URL=http://localhost:5173/payments/return
PAYMENT_CALLBACK_URL=http://localhost:4000/api/payments/callback

# --- PhonePe (only when PAYMENT_GATEWAY=phonepe) ---
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
PHONEPE_TIMEOUT_MS=15000
# Webhook credentials (user-chosen secrets configured on the PhonePe merchant dashboard)
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# --- External services ---
# Piston code-execution API base URL.
PISTON_URL=

# --- Essay AI grading (worker) ---
# Provider: mock (default, no network) | microservice | llm. See
# apps/worker/.env.example for the per-provider settings.
ESSAY_AI_PROVIDER=mock
ESSAY_AI_TIMEOUT_MS=45000
# microservice adapter (was hardcoded 32.194.25.0:8000 — now env-only):
# ESSAY_AI_URL=
# ESSAY_AI_HEADER_NAME=
# ESSAY_AI_HEADER_VALUE=
# llm adapter:
# ESSAY_LLM_URL=
# ESSAY_LLM_API_KEY=
# ESSAY_LLM_MODEL=gpt-4o-mini

# --- Web SPA (Vite; only VITE_* vars are exposed to the browser) ---
# Empty in dev (same-origin via Vite proxy). Set for split deployments.
VITE_API_URL=

# --- Neon → Mongo migration DRY-RUN tool (apps/api/src/migration/run.ts) ---
# Only used by the standalone migration script; NOT read by the running app.
# Reads Postgres READ-ONLY (SELECT only); writes to a SCRATCH Mongo DB only.
# MIGRATION_PG_URL: Neon Postgres connection string (source, read-only).
# MIGRATION_PG_URL=postgres://user:pass@host/db?sslmode=require
# MIGRATION_MONGO_URI: Mongo server for the SCRATCH copy (db name is overridden).
# MIGRATION_MONGO_URI=mongodb://localhost:27017
# Scratch DB name; defaults to codeapt_migration_test. MUST NOT be the real app DB.
# MIGRATION_TARGET_DB=codeapt_migration_test
