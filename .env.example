# ============================================================================
# CodeApt — FULL environment inventory (root reference)
# ============================================================================
# This is the .env docker-compose reads (api + worker load it whole via
# `env_file: .env`). Copy to `.env` and fill it in. NEVER commit real secrets.
# Each app also has its own .env.example (apps/api, apps/worker, apps/web) with
# the subset it needs for `pnpm dev`. All datetimes are UTC; IST is display-only.
#
# THREE CATEGORIES (the middle one is the dangerous one):
#   [REQUIRED]  the process refuses to boot / `docker compose up` fails loudly
#               when unset. Safe: you find out immediately.
#   [OPTIONAL]  has a sane default; unset is fine.
#   [SILENT!]   OPTIONAL in code, but unset SILENTLY DISABLES a capability with
#               no crash and (today) only an INFO log — the whole point of this
#               file is that these are never forgotten. Each is flagged below
#               with what breaks when it's absent.
# ----------------------------------------------------------------------------

# --- Shared runtime ---
NODE_ENV=development                 # [OPTIONAL] compose forces =production
LOG_LEVEL=info                       # [OPTIONAL]

# --- Datastores (REQUIRED) ---
# [REQUIRED] compose guards these with ${VAR:?} — a missing value fails `up`.
# In production these are the MANAGED Mongo/Redis, NEVER a local container.
MONGODB_URI=mongodb://127.0.0.1:27017/codeapt
REDIS_URL=redis://localhost:6379

# --- API server ---
PORT=4000                            # [OPTIONAL]
# [REQUIRED] compose-guarded. The REAL web origin in prod (e.g.
# https://app.example.com). Unset in code defaults to localhost:5173, which
# would silently break the real origin — hence the compose ${VAR:?} guard.
CORS_ORIGIN=http://localhost:5173

# --- Auth secrets (REQUIRED — no fallbacks in code; compose-guarded) ---
# Generate strong random values, e.g. `openssl rand -hex 32`.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m                   # [OPTIONAL]
JWT_REFRESH_TTL=30d                  # [OPTIONAL]

# --- Auth cookies ---
COOKIE_SAMESITE=lax                  # [OPTIONAL]
# COOKIE_DOMAIN=                     # [OPTIONAL]

# --- Auth rate limiting ---
AUTH_RATE_LIMIT_WINDOW_MS=900000     # [OPTIONAL]
AUTH_RATE_LIMIT_MAX=20               # [OPTIONAL]

# --- Roster importer ---
# [OPTIONAL] default password set on bulk-provisioned students (reset on first
# login). Override in shared envs.
BULK_ENROLL_DEFAULT_PASSWORD=CodeApt@123

# --- Admin bootstrap (seed:admin script only) ---
ADMIN_USERNAME=                      # [OPTIONAL] seed-only
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
ADMIN_ROLL_NUMBER=ADMIN-0001

# --- LLM Gateway (multi-provider router; api + worker) ---
# [SILENT!] Server-side key that encrypts provider API keys AT REST
# (AES-256-GCM; any string >=16 chars, stretched to 32 bytes via SHA-256).
# UNSET → the LLM gateway stays OFF and the app runs single-provider fallback
# (no rotation / cooldown / governor). It logs ONE INFO line at boot and looks
# fine otherwise — this is the exact var that was missing in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
LLM_GATEWAY_TIMEOUT_MS=45000         # [OPTIONAL]

# --- Cloudinary (media hosting; api) ---
# [SILENT!] UNSET → any media upload fails the moment it's needed: speaking
# audio takes, authoring-time TTS clips, etc. No boot error — it breaks only
# when a college uses Communication. Set all three together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- ASR / TTS (speech spine; api authoring TTS + worker transcription) ---
# [SILENT!] Base URL of the self-hosted faster-whisper container (compose
# default: http://asr:2600). UNSET → authoring TTS 503s and every speech job
# fails the moment Communication is enabled — no boot error.
ASR_URL=http://asr:2600
ASR_TIMEOUT_MS=30000                 # [OPTIONAL] (worker; api authoring uses 60000)
# ASR_FALLBACK_URL=                  # [OPTIONAL] secondary ASR (worker)
# [OPTIONAL] demo/offline ONLY — canned transcript / canned TTS WAV, no network.
# NEVER enable in prod.
ASR_MOCK=false                       # worker
TTS_MOCK=false                       # api authoring

# --- Code execution (Piston; worker) ---
# [SILENT!] Base URL (compose default: http://piston:2000/api/v2). UNSET → code
# jobs fail with a clear message when a student runs code — no boot error.
PISTON_URL=
PISTON_FALLBACK_URL=https://emkc.org/api/v2/piston  # [OPTIONAL] public fallback
PISTON_TIMEOUT_MS=15000              # [OPTIONAL]
PISTON_PIN_RUNTIME_VERSIONS=false    # [OPTIONAL] false → request "*" (instance-safe)
PISTON_MOCK=false                    # [OPTIONAL] demo/offline only; NEVER in prod
# PISTON_HEADER_NAME=                # [OPTIONAL] extra header (e.g. anti-phishing)
# PISTON_HEADER_VALUE=

# --- Essay AI grading (worker) + keyword generation (api) ---
# [OPTIONAL] Provider: mock (default, no network) | microservice | llm. With
# `mock`, essay scoring / keyword-gen fall back to deterministic extraction —
# functional, just not AI-assisted.
ESSAY_AI_PROVIDER=mock
ESSAY_AI_TIMEOUT_MS=45000
# microservice adapter:
# ESSAY_AI_URL=
# ESSAY_AI_HEADER_NAME=
# ESSAY_AI_HEADER_VALUE=
# llm adapter (OpenAI-compatible chat endpoint):
# ESSAY_LLM_URL=
# ESSAY_LLM_API_KEY=
# ESSAY_LLM_MODEL=gpt-4o-mini

# --- Coding-profile refresh (worker) ---
# [OPTIONAL] per-platform outbound timeout (Codeforces/LeetCode/CodeChef). The
# worker must reach those hosts or refreshes degrade to `error` (last data kept).
CODING_REFRESH_TIMEOUT_MS=12000

# --- Misc external ---
AI_SERVICE_URL=                      # [OPTIONAL] legacy AI microservice base URL

# --- Payments (api) ---
PAYMENT_GATEWAY=mock                 # [OPTIONAL] mock (offline) | phonepe
PAYMENT_MOCK_SALT=mock-payment-salt-dev-only
PAYMENT_REDIRECT_URL=http://localhost:5173/payments/return
PAYMENT_CALLBACK_URL=http://localhost:4000/api/payments/callback

# --- PhonePe ([SILENT!] but only when PAYMENT_GATEWAY=phonepe) ---
# UNSET while PAYMENT_GATEWAY=phonepe → live checkout fails at call time.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
PHONEPE_TIMEOUT_MS=15000
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# --- Web SPA (Vite; only VITE_* vars reach the browser) ---
VITE_API_URL=                        # [OPTIONAL] empty in dev (same-origin proxy)

# --- Neon → Mongo migration DRY-RUN tool (standalone script; NOT read by apps) ---
# Reads Postgres READ-ONLY; writes to a SCRATCH Mongo DB only.
# MIGRATION_PG_URL=postgres://user:pass@host/db?sslmode=require
# MIGRATION_MONGO_URI=mongodb://localhost:27017
# MIGRATION_TARGET_DB=codeapt_migration_test   # MUST NOT be the real app DB
